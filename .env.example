# Copy this file to .env and fill in your own values. Do not commit .env.

# Required for website analysis and email drafting.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Required only when you send mail. Use a Gmail app password, not your login password.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Optional. Display name on messages you send. Defaults to "Your Name".
SENDER_NAME=Your Name
