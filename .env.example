# Copy this file to .env and fill in your own values. Do not commit .env.
# The values below are placeholders. The app treats them as unset.

# Set to 1 to run the saved sample companies. No API key and no network.
# `make demo` sets this for you.
DEMO_MODE=0

# Required for a live website analysis and a live draft. Not used in demo mode.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Required only when you send a real email. Use a Gmail app password, not your login password.
# Not used in demo mode.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Optional. Display name on messages you send. Defaults to "Your Name".
SENDER_NAME=Your Name

# Optional. DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
